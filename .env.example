# Shared server runtime configuration
PORT=5010
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/life_rpg
JWT_SECRET=replace_with_a_long_secure_random_secret
JWT_EXPIRES_IN=7d
RESET_OTP_HASH_SECRET=replace_with_a_long_secure_random_secret
CLIENT_URL=http://localhost:5173

# Resend configuration for password reset
RESEND_API_KEY=
EMAIL_FROM=Life RPG <onboarding@resend.dev>

# AI configuration (optional)
AI_PROVIDER=optional
AI_API_KEY=
AI_MODEL=
AI_API_URL=
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=3600000

# Frontend configuration
VITE_API_URL=http://localhost:5010/api
